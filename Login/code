<script>
  // Simple interactive toggle for password visibility
  const toggleBtn = document.getElementById('toggle-password');
  const passwordInput = document.getElementById('chamber-password');
  const eyeIcon = document.getElementById('eye-icon');

  if (toggleBtn && passwordInput && eyeIcon) {
    toggleBtn.addEventListener('click', () => {
      const isPassword = passwordInput.getAttribute('type') === 'password';
      passwordInput.setAttribute('type', isPassword ? 'text' : 'password');
      eyeIcon.textContent = isPassword ? 'visibility_off' : 'visibility';
    });
  }

  // Persona Pill Switcher toggle interaction
  const advocateBtn = document.getElementById('persona-advocate');
  const clientBtn = document.getElementById('persona-client');

  if (advocateBtn && clientBtn) {
    advocateBtn.addEventListener('click', () => {
      advocateBtn.className = 'flex-1 py-1.5 px-3 rounded text-center font-label-caps text-label-caps uppercase transition-all duration-150 bg-surface-container-lowest text-primary shadow-sm';
