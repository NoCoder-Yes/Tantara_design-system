<!-- Client-side Interactive Script for Checklist Toggle & Feedback -->
<script>
    (function() {
      const selectAllBtn = document.getElementById('btn-select-all');
      const deselectAllBtn = document.getElementById('btn-deselect-all');
      const checkboxes = document.querySelectorAll('.bundle-check');
      const compileBtn = document.getElementById('btn-compile-bundle');

      if (selectAllBtn && checkboxes.length) {
        selectAllBtn.addEventListener('click', () => {
          checkboxes.forEach(cb => cb.checked = true);
        });
      }

      if (deselectAllBtn && checkboxes.length) {
        deselectAllBtn.addEventListener('click', () => {
          checkboxes.forEach(cb => cb.checked = false);
        });
      }

      if (compileBtn) {
        compileBtn.addEventListener('click', () => {
          const originalText = compileBtn.innerHTML;
          compileBtn.innerHTML = '<span class="material-symbols-outlined text-[20px] animate-spin">refresh</span> Compiling Bundle...';
          compileBtn.disabled = true;
          setTimeout(() => {
            compileBtn.innerHTML = '<span class="material-symbols-outlined text-[20px]">check_circle</span> Paperbook Generated!';
            setTimeout(() => {
              compileBtn.innerHTML = originalText;
              compileBtn.disabled = false;
            }, 2500);
          }, 1500);
        });
      }
    })();
  </script>
