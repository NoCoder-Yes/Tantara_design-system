<script>
  function fillPrompt(text) {
    const input = document.getElementById('tantara-ai-input');
    if (input) {
      input.value = text;
      input.focus();
    }
  }

  document.getElementById('tantara-send-btn')?.addEventListener('click', () => {
    const input = document.getElementById('tantara-ai-input');
    if (input && input.value.trim() !== '') {
      input.placeholder = 'Analyzing arbitration authorities and provisions...';
      const prev = input.value;
      input.value = '';
      setTimeout(() => {
        input.value = 'TANTARA Analysis for: "' + prev + '" ready. Opening advisory drawer...';
      }, 700);
    }
  });
